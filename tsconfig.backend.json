{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".backend-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "backend/src/**/*.ts",
    "lib/offers.ts",
    "lib/booking-types.ts",
    "lib/booking-catalog.ts",
    "lib/data.ts"
  ]
}
